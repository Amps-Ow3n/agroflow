DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
ENABLE_AUDIT_LOGS=true
ENABLE_DECISION_LOGS=true
EVIDENCE_STORAGE_DIR=storage/evidence
MAX_EVIDENCE_FILE_SIZE=10485760
SESSION_COOKIE_NAME=agroflow_access_token
CSRF_COOKIE_NAME=agroflow_csrf
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE=1800
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_POLICY_VERSION=2026-09-11
